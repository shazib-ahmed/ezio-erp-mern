// generator and datasource
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ==========================================
// 1. SYSTEM & TENANCY (The Foundation)
// ==========================================

model Industry {
  id          Int       @id @default(autoincrement())
  name        String    @unique // e.g., Garments, Pharmacy, Retail, IT
  description String?
  modules     Module[]  // Modules available for this industry
  tenants     Tenant[]
  attributes  Json?     // Dynamic fields configuration for products in this industry

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  @@index([name])
}

model Tenant {
  id            Int       @id @default(autoincrement())
  name          String    @unique // Company Name
  phone         String    @unique // Business Phone
  tenantId      Int       // User ID of the tenant creator/owner
  industryId    Int
  industry      Industry  @relation(fields: [industryId], references: [id])
  
  // Relations to business data
  users         User[]
  products      Product[]
  customers     Customer[]
  sales         Sale[]
  expenses      Expense[]
  transactions  Transaction[]
  accounts      Account[]
  categories    Category[]
  brands        Brand[]
  activeModules Module[]  @relation("TenantModules")
  
  logo          String?   // Company Logo URL/Path
  currencyCode  String    @default("USD")
  currencySymbol String   @default("$")
  taxRate        Decimal  @default(0.0) @db.Decimal(5, 2)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  @@index([tenantId])
  @@index([industryId])
  @@index([name])
  @@index([phone])
}

enum Plan {
  FREE
  BASIC
  PRO
  ENTERPRISE
}

model User {
  id        Int      @id @default(autoincrement())
  name      String?
  username  String   @unique
  email     String   @unique
  phone     String   @unique
  password  String
  
  roles     UserRole[]
  tenantId  Int?
  tenant    Tenant?  @relation(fields: [tenantId], references: [id])
  
  refreshToken String? @db.Text
  
  avatar    String?  // User Profile Image

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  @@index([email])
  @@index([username])
  @@index([phone])
  @@index([tenantId])
}



model UserRole {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  roleId    Int
  role      Role     @relation(fields: [roleId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  @@unique([userId, roleId])
  @@index([userId])
  @@index([roleId])
}

model Module {
  id          Int       @id @default(autoincrement())
  name        String    @unique
  code        String    @unique
  icon        String?
  features    Feature[]
  permissions Permission[]
  industries  Industry[]
  tenants     Tenant[]   @relation("TenantModules")
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  @@index([code])
}

model Feature {
  id          Int          @id @default(autoincrement())
  name        String
  code        String       @unique
  moduleId    Int
  module      Module       @relation(fields: [moduleId], references: [id])
  permissions Permission[]
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  @@index([moduleId])
  @@index([code])
}

model Permission {
  id          Int       @id @default(autoincrement())
  name        String
  code        String    @unique // e.g., USER_VIEW, SALE_CREATE
  
  moduleId    Int
  module      Module    @relation(fields: [moduleId], references: [id])
  featureId   Int
  feature     Feature   @relation(fields: [featureId], references: [id])
  
  roles       RolePermission[]
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  @@index([moduleId])
  @@index([featureId])
  @@index([code])
}

model Role {
  id          Int              @id @default(autoincrement())
  name        String           @unique // e.g., SUPER_ADMIN, TENANT, MANAGER, STAFF
  permissions RolePermission[]
  users       UserRole[]
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  @@index([name])
}

model RolePermission {
  id           Int        @id @default(autoincrement())
  roleId       Int
  role         Role       @relation(fields: [roleId], references: [id])
  permissionId Int
  permission   Permission @relation(fields: [permissionId], references: [id])

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
}

// ==========================================
// 2. INVENTORY MODULE
// ==========================================

model Product {
  id            Int      @id @default(autoincrement())
  name          String
  categoryId    Int
  category      Category @relation(fields: [categoryId], references: [id])
  brandId       Int?
  brand         Brand?   @relation(fields: [brandId], references: [id])
  attributes    Json?    // For Industry Specific (e.g., Size: XL, Color: Blue)
  thumb         String?  // Dedicated product thumbnail image URL
  
  tenantId      Int
  tenant        Tenant   @relation(fields: [tenantId], references: [id])
  saleItems     SaleItem[]

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  deletedAt     DateTime?

  @@index([tenantId])
  @@index([categoryId])
  @@index([brandId])
}

model Brand {
  id          Int       @id @default(autoincrement())
  name        String
  logo        String?   // Brand Logo Image URL
  tenantId    Int
  tenant      Tenant    @relation(fields: [tenantId], references: [id])
  products    Product[]
  
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  @@index([tenantId])
}

model Category {
  id          Int       @id @default(autoincrement())
  name        String
  
  tenantId    Int
  tenant      Tenant    @relation(fields: [tenantId], references: [id])
  products    Product[]

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  @@index([tenantId])
  @@index([name])
}

// ==========================================
// 3. POS & SALES (With Baki Khata Logic)
// ==========================================

model Customer {
  id          Int      @id @default(autoincrement())
  name        String
  phone       String?
  email       String?
  address     String?
  totalDue    Decimal  @default(0.0) @db.Decimal(18, 2) // Total Outstanding Baki
  
  tenantId    Int
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  sales       Sale[]
  transactions Transaction[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  @@index([tenantId])
  @@index([phone])
}

model Sale {
  id              Int            @id @default(autoincrement())
  invoiceNo       String         @unique // e.g., INV-2026-0001
  totalAmount     Decimal        @db.Decimal(18, 2)
  discount        Decimal        @default(0.0) @db.Decimal(18, 2)
  payableAmount   Decimal        @db.Decimal(18, 2)
  paidAmount      Decimal        @db.Decimal(18, 2)
  dueAmount       Decimal        @default(0.0) @db.Decimal(18, 2)
  
  status          PaymentStatus  @default(PAID)
  tenantId        Int
  tenant          Tenant         @relation(fields: [tenantId], references: [id])
  customerId      Int?
  customer        Customer?      @relation(fields: [customerId], references: [id])
  items           SaleItem[]
  transactions    Transaction[]
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  @@index([tenantId])
  @@index([customerId])
  @@index([invoiceNo])
}

model SaleItem {
  id          Int      @id @default(autoincrement())
  saleId      Int
  sale        Sale     @relation(fields: [saleId], references: [id])
  productId   Int
  product     Product  @relation(fields: [productId], references: [id])
  quantity    Int
  unitPrice   Decimal  @db.Decimal(18, 2)
  subTotal    Decimal  @db.Decimal(18, 2)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  @@index([saleId])
  @@index([productId])
}

enum PaymentStatus {
  PAID
  PARTIAL
  DUE
}

// ==========================================
// 4. TRANSACTION & LEDGER (Professional Tracking)
// ==========================================

model Transaction {
  id              Int             @id @default(autoincrement())
  trxId           String          @unique // e.g., TRX-987654321
  amount          Decimal         @db.Decimal(18, 2)
  type            TransactionType 
  purpose         String          // e.g., "Product Sale", "Baki Payment", "Rent"
  method          PaymentMethod   @default(CASH)
  referenceNo     String?         // Check No, Bkash TrxID, Bank Ref
  note            String?
  
  tenantId        Int
  tenant          Tenant          @relation(fields: [tenantId], references: [id])
  
  accountId       Int?            // The account associated with this transaction
  account         Account?         @relation(fields: [accountId], references: [id])
  
  // Relations (Optional based on transaction source)
  saleId          Int?
  sale            Sale?           @relation(fields: [saleId], references: [id])
  expenseId       Int?
  expense         Expense?        @relation(fields: [expenseId], references: [id])
  customerId      Int?
  customer        Customer?       @relation(fields: [customerId], references: [id])
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  @@index([tenantId])
  @@index([saleId])
  @@index([expenseId])
  @@index([customerId])
  @@index([trxId])
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  BKASH
  NAGAD
  CARD
}

// ==========================================
// 5. EXPENSE & ACCOUNTS
// ==========================================

model Expense {
  id              Int      @id @default(autoincrement())
  title           String
  category        String   // e.g., Rent, Utility, Salary
  amount          Decimal  @db.Decimal(18, 2)
  expenseDate     DateTime @default(now())
  
  tenantId        Int
  tenant          Tenant   @relation(fields: [tenantId], references: [id])
  transactions    Transaction[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  @@index([tenantId])
}

model Account {
  id          Int      @id @default(autoincrement())
  name        String   // e.g., Main Cash, DBBL Bank, Business Petty Cash
  accountType String   // CASH, BANK, MOBILE_WALLET
  balance     Decimal  @default(0.0) @db.Decimal(18, 2)
  
  tenantId    Int
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  transactions Transaction[]
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  @@index([tenantId])
}